# Forum backend — Arc MAINNET environment.
#
# Copy to /opt/forum/forum.env (mode 600). Every unit in deploy/ that carries
# `EnvironmentFile=-/opt/forum/forum.env` loads it; while the file is absent
# everything keeps its testnet defaults. Read deploy/README.md ("Mainnet
# cut-over") before creating it — the same file flips every unit that loads it.
#
# No secrets belong here; see the ANTHROPIC_* note at the bottom.

# Network: arc-testnet (default when unset) | arc-mainnet.
FORUM_CHAIN=arc-mainnet

# Deployment manifest for the selected chain. Must carry chainId 5042 for
# arc-mainnet; the keeper refuses a manifest written for another chain.
FORUM_DEPLOYMENTS=/opt/forum/deployments/arc-mainnet.json

# RPC used by every keeper, script and the indexer. Per-script overrides still
# win when set: FORUM_INDEXER_RPC (indexer), ARC_RPC (stale-enforcer,
# idle-policy, fee-reconcile). Server-side use goes through Blockdaemon: the
# public https://rpc.mainnet.arc.io rate-limits the indexer's getLogs catch-up.
ARC_RPC_URL=https://rpc.blockdaemon.mainnet.arc.io

# Indexer snapshot. Keep it separate from the testnet file
# (/opt/forum/indexer-state.json): the cursor and the indexed addresses are
# chain-specific and a testnet snapshot would be read as mainnet history.
FORUM_INDEXER_STATE=/opt/forum/indexer-state-mainnet.json

# AgoraMind LLM provider (forum-agora-mind-mainnet.service). Leave BOTH lines
# commented here and put the real values in /root/.forum-keys/agora.env
# (mode 600, never committed), which that unit loads after this file. An
# uncommented empty ANTHROPIC_API_KEY= is read as "no key" and silently selects
# the deterministic mock provider.
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-4-6
